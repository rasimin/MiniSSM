<Window x:Class="SSMS.UnsavedChangesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unsaved Query"
        Width="550" Height="224"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Background="Transparent"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Secondary Dialog Button -->
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="85"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Foreground" Value="#D0D0D0"/>
            <Setter Property="Background" Value="#252830"/>
            <Setter Property="BorderBrush" Value="#3F4350"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#323642"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#505565"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1C1E24"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Dialog Button -->
        <Style x:Key="PrimaryDialogButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="BorderBrush" Value="#007ACC"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1C8BD6"/>
                    <Setter Property="BorderBrush" Value="#1C8BD6"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#005999"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Margin="10" Background="#181A1F" BorderBrush="#2A2D35" BorderThickness="1" CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.6" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#111317" BorderBrush="#2A2D35" BorderThickness="0,0,0,1" CornerRadius="7,7,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="Unsaved changes" Margin="14,0,40,0" VerticalAlignment="Center" Foreground="#F0F0F0" FontSize="12" FontWeight="SemiBold"/>
                    <Button Width="28" Height="24" Margin="0,0,6,0" HorizontalAlignment="Right" VerticalAlignment="Center" Content="✕" Foreground="#888C94" Background="Transparent" BorderThickness="0" FontSize="11" Cursor="Hand" Click="CancelButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="3">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#FF5555"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="18,14,18,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Width="34" Height="34" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#2C2210" BorderBrush="#5C4515" BorderThickness="1" CornerRadius="17">
                    <TextBlock Text="!" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#F5A623" FontSize="18" FontWeight="Bold"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Save this query before closing?" Foreground="#F0F0F0" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock x:Name="QueryNameText" Margin="0,6,0,0" Foreground="#007ACC" FontSize="12" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>

            <!-- Footer Buttons -->
            <Border Grid.Row="2" Background="#111317" BorderBrush="#2A2D35" BorderThickness="0,1,0,0" CornerRadius="0,0,7,7">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Button Content="Cancel" Style="{StaticResource DialogButton}" Click="CancelButton_Click"/>
                    <Button Content="Don't Save" Style="{StaticResource DialogButton}" Click="DontSaveButton_Click"/>
                    <Button x:Name="BtnDontSaveAll" Content="Don't Save All" Style="{StaticResource DialogButton}" Visibility="Collapsed" Click="DontSaveAllButton_Click"/>
                    <Button Content="Save" Style="{StaticResource PrimaryDialogButton}" IsDefault="True" Click="SaveButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
