<Window x:Class="SSMS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="MiniSSMS - Desktop SQL Client" 
        Icon="/Assets/MiniSSMS.ico"
        Height="760" Width="1100"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="#181818"
        Foreground="#CCCCCC"
        FontFamily="Segoe UI, Arial"
        AllowDrop="True"
        Loaded="Window_Loaded"
        PreviewDragOver="Window_PreviewDragOver"
        Drop="Window_Drop"
        KeyDown="Window_KeyDown"
        StateChanged="Window_StateChanged">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" GlassFrameThickness="0" CornerRadius="0" ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- Window Caption Button Styles -->
        <Style x:Key="WindowCaptionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A2D2E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#37373D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowCaptionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C42B1C"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B12316"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- VS Code Toolbar Button Styles -->
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="MinWidth" Value="30"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="1" 
                                CornerRadius="3" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2A2D2E"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#3C3C3C"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#37373D"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#3C3C3C"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#6A6A6A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExecuteButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Foreground" Value="#4EC9B0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="1" 
                                CornerRadius="3" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1A3831"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#4EC9B0"/>
                                <Setter Property="Foreground" Value="#4EC9B0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#244E44"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#4EC9B0"/>
                                <Setter Property="Foreground" Value="#4EC9B0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#6A6A6A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dropdown ComboBox Dark Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderBrush" Value="#3C3C3C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid Name="MainGrid">
                            <Border x:Name="MainBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3"
                                    SnapsToDevicePixels="True"/>
                            
                            <ToggleButton Name="ToggleButton" 
                                           Background="Transparent" 
                                           BorderThickness="0" 
                                           Foreground="{TemplateBinding Foreground}"
                                           Focusable="false"
                                           IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <TextBlock Text="▼" FontSize="8" Foreground="#8A8A8A" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False" 
                                               Content="{TemplateBinding SelectionBoxItem}"
                                               ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                               ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                               Margin="8,3,25,3"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Left" />
                            
                            <TextBox x:Name="PART_EditableTextBox"
                                     HorizontalAlignment="Stretch" 
                                     VerticalAlignment="Center" 
                                     Margin="8,0,25,0" 
                                     Focusable="True" 
                                     Background="Transparent" 
                                     Foreground="{TemplateBinding Foreground}"
                                     CaretBrush="#FFFFFF"
                                     BorderThickness="0"
                                     FontSize="12"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"
                                     Visibility="Collapsed">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="OverridesDefaultStyle" Value="True"/>
                                        <Setter Property="AllowDrop" Value="True"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#CCCCCC"/>
                                        <Setter Property="SelectionBrush" Value="#007ACC"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TextBox">
                                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Background="Transparent" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" VerticalAlignment="Center"/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>

                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Name="DropDownBorder" Background="#252526" BorderBrush="#3C3C3C" BorderThickness="1" CornerRadius="3" Margin="0,2,0,0" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#555555"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#007ACC"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="MainBorder" Property="BorderBrush" Value="#007ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2A2D2E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#007ACC"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TreeView">
            <Setter Property="Background" Value="#181818"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderBrush" Value="#2B2B2B"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeView">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ItemsPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource StandardScrollBar}"/>
            </Style.Resources>
        </Style>

        <Style TargetType="TreeViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="2,1,0,1"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="12.5"/>
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnTreeViewItemPreviewMouseRightButtonDown"/>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnTreeViewItemPreviewMouseLeftButtonDown"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            
                            <!-- Header content container -->
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}"
                                    MinHeight="22"
                                    SnapsToDevicePixels="True"
                                    CornerRadius="3"
                                    Margin="0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="19"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Expander ToggleButton -->
                                    <ToggleButton x:Name="Expander"
                                                  ClickMode="Press"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent" Width="16" Height="16">
                                                    <Path x:Name="Arrow"
                                                          Fill="#9D9D9D"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Data="M 0,0 L 4,4 L 0,8 Z"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Arrow" Property="Fill" Value="#FFFFFF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Arrow" Property="Data" Value="M 0,0 L 8,0 L 4,4 Z"/>
                                                        <Setter TargetName="Arrow" Property="Fill" Value="#CCCCCC"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    
                                    <!-- Header Content -->
                                    <ContentPresenter Grid.Column="1"
                                                      ContentSource="Header"
                                                      Margin="3,2"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Grid>
                            </Border>
                            
                            <!-- Items Host (for children nodes) -->
                            <ItemsPresenter x:Name="ItemsHost"
                                            Grid.Row="1"
                                            Margin="15,0,0,0"
                                            Visibility="Collapsed"/>
                        </Grid>
                        
                        <ControlTemplate.Triggers>
                            <!-- Expand/collapse logic -->
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <!-- Hide expander if no children -->
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            
                            <!-- Hover state -->
                            <Trigger Property="IsMouseOver" SourceName="Bd" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2D2E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            
                            <!-- Selected state -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#37373D"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <!-- Selected but Inactive state -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsSelectionActive" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#37373D"/>
                                <Setter Property="Foreground" Value="#CCCCCC"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="BorderBrush" Value="#2B2B2B"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="QueryTabHeaderHorizontalScrollBar" TargetType="ScrollBar">
            <Setter Property="Background" Value="#181818"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="MinHeight" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Height="6" Background="#181818" SnapsToDevicePixels="True">
                            <Track x:Name="PART_Track"
                                   Orientation="{TemplateBinding Orientation}"
                                   IsDirectionReversed="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Opacity="0" Focusable="False" IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Opacity="0" Focusable="False" IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinWidth="24" Height="6">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder"
                                                        Height="6"
                                                        Background="#4F4F4F"
                                                        CornerRadius="3"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#7A7A7A"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QueryTabHeaderScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Background" Value="#181818"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ScrollContentPresenter Grid.Row="0"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"/>

                            <ScrollBar x:Name="PART_HorizontalScrollBar"
                                       Grid.Row="1"
                                       Orientation="Horizontal"
                                       Height="4"
                                       Style="{StaticResource QueryTabHeaderHorizontalScrollBar}"
                                       Value="{TemplateBinding HorizontalOffset}"
                                       Maximum="{TemplateBinding ScrollableWidth}"
                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QueryTabsControl" TargetType="TabControl">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="BorderBrush" Value="#2B2B2B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <ScrollViewer Grid.Row="0"
                                          Background="#181818"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          CanContentScroll="False"
                                          Focusable="False"
                                          Style="{StaticResource QueryTabHeaderScrollViewer}">
                                <TabPanel x:Name="HeaderPanel"
                                          IsItemsHost="True"
                                          KeyboardNavigation.TabIndex="1"
                                          Panel.ZIndex="1"/>
                            </ScrollViewer>

                            <Border Grid.Row="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="0">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  Margin="{TemplateBinding Padding}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border" Background="{TemplateBinding Background}" BorderBrush="#2B2B2B" BorderThickness="0,0,1,1" Padding="12,6">
                            <ContentPresenter x:Name="ContentSite"
                                               ContentSource="Header"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1E1E1E"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="0,2,1,0"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#007ACC"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter Property="Foreground" Value="#9D9D9D"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#333333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Integrated Compact Title Bar & Toolbar -->
            <RowDefinition Height="*"/>    <!-- Main Content -->
            <RowDefinition Height="26"/>   <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- 0. Integrated Compact Title Bar & Toolbar -->
        <Border Grid.Row="0" Background="#181818" BorderBrush="#2B2B2B" BorderThickness="0,0,0,1" Padding="6,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="ToolbarPanel" Grid.Column="0" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Border Name="ToolbarObjectExplorer" Background="Transparent" Padding="2,0" Margin="0,0,4,0"
                            PreviewMouseLeftButtonDown="ToolbarItem_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="ToolbarItem_PreviewMouseMove"
                            PreviewMouseLeftButtonUp="ToolbarItem_PreviewMouseLeftButtonUp">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⋮" Foreground="#6A6A6A" VerticalAlignment="Center" Margin="2,0,4,0" Cursor="SizeAll" FontSize="14" FontWeight="Bold"/>
                            <Button x:Name="BtnToggleObjectExplorer" Style="{StaticResource ToolbarButton}" Content="☰" Click="BtnToggleObjectExplorer_Click" ToolTip="Hide Object Explorer (F8)"/>
                        </StackPanel>
                    </Border>
                    
                    <Border Name="ToolbarExecute" Background="Transparent" Padding="2,0" Margin="0,0,4,0"
                            PreviewMouseLeftButtonDown="ToolbarItem_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="ToolbarItem_PreviewMouseMove"
                            PreviewMouseLeftButtonUp="ToolbarItem_PreviewMouseLeftButtonUp">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⋮" Foreground="#6A6A6A" VerticalAlignment="Center" Margin="2,0,4,0" Cursor="SizeAll" FontSize="14" FontWeight="Bold"/>
                            <Button Style="{StaticResource ExecuteButton}" Content="▶ Execute" Click="BtnExecute_Click" Margin="5,0" ToolTip="Execute Query (F5)"/>
                        </StackPanel>
                    </Border>
                    
                    <Border Name="ToolbarDatabase" Background="Transparent" Padding="2,0" Margin="0,0,4,0"
                            PreviewMouseLeftButtonDown="ToolbarItem_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="ToolbarItem_PreviewMouseMove"
                            PreviewMouseLeftButtonUp="ToolbarItem_PreviewMouseLeftButtonUp">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⋮" Foreground="#6A6A6A" VerticalAlignment="Center" Margin="2,0,4,0" Cursor="SizeAll" FontSize="14" FontWeight="Bold"/>
                            <Label Content="Database:" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="5,0" FontSize="12"/>
                            <ComboBox x:Name="CboDatabases" Width="200" VerticalAlignment="Center" SelectionChanged="CboDatabases_SelectionChanged"/>
                        </StackPanel>
                    </Border>
                    
                    <Border Name="ToolbarSave" Background="Transparent" Padding="2,0" Margin="0,0,4,0"
                            PreviewMouseLeftButtonDown="ToolbarItem_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="ToolbarItem_PreviewMouseMove"
                            PreviewMouseLeftButtonUp="ToolbarItem_PreviewMouseLeftButtonUp">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⋮" Foreground="#6A6A6A" VerticalAlignment="Center" Margin="2,0,4,0" Cursor="SizeAll" FontSize="14" FontWeight="Bold"/>
                            <Button Style="{StaticResource ToolbarButton}" Content="💾" Click="BtnSaveQuery_Click" ToolTip="Save Query File (Ctrl+S)"/>
                        </StackPanel>
                    </Border>
                    
                    <Border Name="ToolbarSaveAs" Background="Transparent" Padding="2,0" Margin="0,0,4,0"
                            PreviewMouseLeftButtonDown="ToolbarItem_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="ToolbarItem_PreviewMouseMove"
                            PreviewMouseLeftButtonUp="ToolbarItem_PreviewMouseLeftButtonUp">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#x22EE;" Foreground="#6A6A6A" VerticalAlignment="Center" Margin="2,0,4,0" Cursor="SizeAll" FontSize="14" FontWeight="Bold"/>
                            <Button Style="{StaticResource ToolbarButton}" Content="&#x1F4BE;+" Click="BtnSaveAsQuery_Click" ToolTip="Save Query As (Ctrl+Shift+S)"/>
                        </StackPanel>
                    </Border>

                    <Border Name="ToolbarOpen" Background="Transparent" Padding="2,0" Margin="0,0,4,0"
                            PreviewMouseLeftButtonDown="ToolbarItem_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="ToolbarItem_PreviewMouseMove"
                            PreviewMouseLeftButtonUp="ToolbarItem_PreviewMouseLeftButtonUp">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⋮" Foreground="#6A6A6A" VerticalAlignment="Center" Margin="2,0,4,0" Cursor="SizeAll" FontSize="14" FontWeight="Bold"/>
                            <Button Style="{StaticResource ToolbarButton}" Content="📂" Click="BtnOpenQuery_Click" ToolTip="Open SQL File (Ctrl+O)"/>
                        </StackPanel>
                    </Border>

                    <Border Name="ToolbarQueryTools" Background="Transparent" Padding="2,0" Margin="0,0,4,0"
                            PreviewMouseLeftButtonDown="ToolbarItem_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="ToolbarItem_PreviewMouseMove"
                            PreviewMouseLeftButtonUp="ToolbarItem_PreviewMouseLeftButtonUp">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#x22EE;" Foreground="#6A6A6A" VerticalAlignment="Center" Margin="2,0,4,0" Cursor="SizeAll" FontSize="14" FontWeight="Bold"/>
                            <Button Style="{StaticResource ToolbarButton}" Content="Query Tools" Click="BtnQueryTools_Click"
                                    ToolTip="Parse, execution plan, and SQL formatting"/>
                        </StackPanel>
                    </Border>

                    <Border Name="ToolbarSettings" Background="Transparent" Padding="2,0" Margin="0,0,4,0"
                            PreviewMouseLeftButtonDown="ToolbarItem_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="ToolbarItem_PreviewMouseMove"
                            PreviewMouseLeftButtonUp="ToolbarItem_PreviewMouseLeftButtonUp">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⋮" Foreground="#6A6A6A" VerticalAlignment="Center" Margin="2,0,4,0" Cursor="SizeAll" FontSize="14" FontWeight="Bold"/>
                            <Button Style="{StaticResource ToolbarButton}" Click="BtnSettings_Click"
                                    ToolTip="Settings" Padding="5">
                                <Viewbox Width="14" Height="14">
                                    <Path Fill="#CCCCCC"
                                          Data="M12,8.75 C10.21,8.75 8.75,10.21 8.75,12 C8.75,13.79 10.21,15.25 12,15.25 C13.79,15.25 15.25,13.79 15.25,12 C15.25,10.21 13.79,8.75 12,8.75 M19.43,13.75 C19.5,13.18 19.5,12.82 19.43,12.25 L21.54,10.6 L19.54,7.14 L17.05,8.14 C16.6,7.79 16.1,7.5 15.57,7.29 L15.2,4.64 L11.2,4.64 L10.83,7.29 C10.3,7.5 9.8,7.79 9.35,8.14 L6.86,7.14 L4.86,10.6 L6.97,12.25 C6.9,12.82 6.9,13.18 6.97,13.75 L4.86,15.4 L6.86,18.86 L9.35,17.86 C9.8,18.21 10.3,18.5 10.83,18.71 L11.2,21.36 L15.2,21.36 L15.57,18.71 C16.1,18.5 16.6,18.21 17.05,17.86 L19.54,18.86 L21.54,15.4 Z"
                                          Stretch="Uniform"/>
                                </Viewbox>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Name="ToolbarQueryHistory" Background="Transparent" Padding="2,0" Margin="0,0,4,0"
                            PreviewMouseLeftButtonDown="ToolbarItem_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="ToolbarItem_PreviewMouseMove"
                            PreviewMouseLeftButtonUp="ToolbarItem_PreviewMouseLeftButtonUp">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⋮" Foreground="#6A6A6A" VerticalAlignment="Center" Margin="2,0,4,0" Cursor="SizeAll" FontSize="14" FontWeight="Bold"/>
                            <Button Style="{StaticResource ToolbarButton}" Content="🕘" Click="BtnQueryHistory_Click" ToolTip="Query Execution History"/>
                        </StackPanel>
                    </Border>

                    <Border Name="ToolbarComment" Background="Transparent" Padding="2,0" Margin="0,0,4,0"
                            PreviewMouseLeftButtonDown="ToolbarItem_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="ToolbarItem_PreviewMouseMove"
                            PreviewMouseLeftButtonUp="ToolbarItem_PreviewMouseLeftButtonUp">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⋮" Foreground="#6A6A6A" VerticalAlignment="Center" Margin="2,0,4,0" Cursor="SizeAll" FontSize="14" FontWeight="Bold"/>
                            <Button Style="{StaticResource ToolbarButton}" Content="--" Click="BtnCommentQuery_Click" ToolTip="Comment Selection (Ctrl+K)"/>
                        </StackPanel>
                    </Border>

                    <Border Name="ToolbarUncomment" Background="Transparent" Padding="2,0" Margin="0,0,4,0"
                            PreviewMouseLeftButtonDown="ToolbarItem_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="ToolbarItem_PreviewMouseMove"
                            PreviewMouseLeftButtonUp="ToolbarItem_PreviewMouseLeftButtonUp">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⋮" Foreground="#6A6A6A" VerticalAlignment="Center" Margin="2,0,4,0" Cursor="SizeAll" FontSize="14" FontWeight="Bold"/>
                            <Button Style="{StaticResource ToolbarButton}" Content="--×" Click="BtnUncommentQuery_Click" ToolTip="Uncomment Selection (Ctrl+Shift+K)"/>
                        </StackPanel>
                    </Border>
                    
                    <Border Name="ToolbarNewQuery" Background="Transparent" Padding="2,0" Margin="0,0,4,0"
                            PreviewMouseLeftButtonDown="ToolbarItem_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="ToolbarItem_PreviewMouseMove"
                            PreviewMouseLeftButtonUp="ToolbarItem_PreviewMouseLeftButtonUp">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⋮" Foreground="#6A6A6A" VerticalAlignment="Center" Margin="2,0,4,0" Cursor="SizeAll" FontSize="14" FontWeight="Bold"/>
                            <Button Style="{StaticResource ToolbarButton}" Content="📄 New Query" Click="BtnNewQuery_Click" ToolTip="New Query Tab (Ctrl+N)"/>
                        </StackPanel>
                    </Border>

                    <Border Name="ToolbarInsertScript" Background="Transparent" Padding="2,0" Margin="0,0,4,0"
                            PreviewMouseLeftButtonDown="ToolbarItem_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="ToolbarItem_PreviewMouseMove"
                            PreviewMouseLeftButtonUp="ToolbarItem_PreviewMouseLeftButtonUp">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⋮" Foreground="#6A6A6A" VerticalAlignment="Center" Margin="2,0,4,0" Cursor="SizeAll" FontSize="14" FontWeight="Bold"/>
                            <Button Style="{StaticResource ToolbarButton}" Content="📝 Insert Script" Click="BtnInsertScript_Click" ToolTip="Insert SQL Script Snippet"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch" WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Text="MiniSSMS v1.1" Foreground="#9D9D9D" VerticalAlignment="Center"
                               Margin="0,0,10,0" FontSize="11" FontStyle="Italic"/>
                    <Button x:Name="BtnTitleMinimize" Content="🗕" Click="BtnTitleMinimize_Click" Style="{StaticResource WindowCaptionButtonStyle}" ToolTip="Minimize"/>
                    <Button x:Name="BtnTitleMaximize" Content="🗖" Click="BtnTitleMaximize_Click" Style="{StaticResource WindowCaptionButtonStyle}" ToolTip="Maximize / Restore"/>
                    <Button x:Name="BtnTitleClose" Content="✕" Click="BtnTitleClose_Click" Style="{StaticResource WindowCloseButtonStyle}" ToolTip="Close"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1. Main Content Splitter (Left: Object Explorer, Right: Editor & Results) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ObjectExplorerColumn" Width="260" MinWidth="180"/>
                <ColumnDefinition x:Name="ObjectExplorerSplitterColumn" Width="3"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Object Explorer -->
            <Grid x:Name="ObjectExplorerPanel" Grid.Column="0" Background="#181818">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#202020" BorderBrush="#2B2B2B" BorderThickness="0,0,1,1" Padding="8,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Object Explorer" FontWeight="SemiBold" Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center" Margin="4,0"/>
                        
                        <Button Grid.Column="1" Style="{StaticResource ToolbarButton}" Click="BtnConnect_Click"
                                ToolTip="Connect to Database Server" Padding="4" Margin="1,0">
                            <Viewbox Width="14" Height="14">
                                <Path Fill="#CCCCCC" Data="M12,2 C7.58,2 4,3.79 4,6 C4,8.21 7.58,10 12,10 C16.42,10 20,8.21 20,6 C20,3.79 16.42,2 12,2 Z M4,8 V11 C4,13.21 7.58,15 12,15 C16.42,15 20,13.21 20,11 V8 C18.3,9.46 15.35,10 12,10 C8.65,10 5.7,9.46 4,8 Z M4,13 V16 C4,18.21 7.58,20 12,20 C16.42,20 20,18.21 20,16 V13 C18.3,14.46 15.35,15 12,15 C8.65,15 5.7,14.46 4,13 Z"/>
                            </Viewbox>
                        </Button>
                        
                        <Button Grid.Column="2" Style="{StaticResource ToolbarButton}" Click="BtnDisconnect_Click"
                                ToolTip="Disconnect Selected Server" Padding="4" Margin="1,0">
                            <Viewbox Width="14" Height="14">
                                <Path Fill="#CCCCCC" Data="M12,2 C7.58,2 4,3.79 4,6 C4,7.47 5.63,8.73 8.16,9.44 L9.68,7.92 C7.45,7.39 6,6.58 6,6 C6,4.9 8.69,3.8 12,3.8 C15.31,3.8 18,4.9 18,6 C18,6.58 16.55,7.39 14.32,7.92 L15.84,9.44 C18.37,8.73 20,7.47 20,6 C20,3.79 16.42,2 12,2 Z M2,2 L1.1,3.1 L19.9,21.9 L21,20.8 L2,2 Z M4,13 V16 C4,18.21 7.58,20 12,20 C13.78,20 15.42,19.67 16.75,19.09 L15.21,17.55 C14.23,17.84 13.15,18 12,18 C8.69,18 6,16.9 6,15.8 V14.2 C6.94,14.7 8.24,15.09 9.76,15.33 L8.22,13.79 C6.08,13.43 4.5,12.56 4,11.5 V13 Z"/>
                            </Viewbox>
                        </Button>

                        <Button Grid.Column="3" Style="{StaticResource ToolbarButton}" Click="BtnSearchObjects_Click"
                                ToolTip="Search objects across databases" Padding="4" Margin="1,0">
                            <Viewbox Width="14" Height="14">
                                <Path Fill="#CCCCCC" Data="M9.5,3 A6.5,6.5 0 1,0 9.5,16 A6.5,6.5 0 0,0 9.5,3 M9.5,5 A4.5,4.5 0 1,1 9.5,14 A4.5,4.5 0 0,1 9.5,5 M14,13 L21,20 L19.5,21.5 L12.5,14.5 Z"/>
                            </Viewbox>
                        </Button>
                        
                        <Button Grid.Column="4" Style="{StaticResource ToolbarButton}" Click="BtnRefreshObjectExplorer_Click"
                                ToolTip="Refresh selected Object Explorer node (Ctrl+Shift+R)" Padding="4" Margin="1,0">
                            <Viewbox Width="14" Height="14">
                                <Path Fill="#CCCCCC" Data="M17.65,6.35 C16.2,4.9 14.21,4 12,4 C7.58,4 4,7.58 4,12 C4,16.42 7.58,20 12,20 C15.73,20 18.84,17.45 19.73,14 L17.65,14 C16.83,16.33 14.61,18 12,18 C8.69,18 6,15.31 6,12 C6,8.69 8.69,6 12,6 C13.66,6 15.14,6.69 16.22,7.78 L13,11 L20,11 L20,4 Z"/>
                            </Viewbox>
                        </Button>
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="1"
                              Background="#181818"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              CanContentScroll="False">
                    <ScrollViewer.Resources>
                        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource StandardScrollBar}"/>
                    </ScrollViewer.Resources>
                    <TreeView x:Name="TreeObjectExplorer"
                              Focusable="True"
                              BorderThickness="0"
                              RequestBringIntoView="TreeObjectExplorer_RequestBringIntoView"
                              PreviewKeyDown="TreeObjectExplorer_PreviewKeyDown"/>
                </ScrollViewer>
            </Grid>

            <!-- Vertical Grid Splitter -->
            <GridSplitter x:Name="ObjectExplorerSplitter" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#2B2B2B" ShowsPreview="True"/>

            <!-- Right Panel: Multi-tab Query Editor & Results -->
            <TabControl x:Name="TabQueryControls" Grid.Column="2" BorderThickness="0" Background="#1E1E1E" Style="{StaticResource QueryTabsControl}" SelectionChanged="TabQueryControls_SelectionChanged">
                <!-- Tab items will be added programmatically here -->
            </TabControl>
        </Grid>

        <!-- 3. Status Bar -->
        <Border Grid.Row="3" Background="#181818" BorderBrush="#2B2B2B" BorderThickness="0,1,0,0" Padding="10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock x:Name="TxtStatusServer" Text="Connected to Server" Foreground="#4EC9B0" FontSize="11" VerticalAlignment="Center"/>
                    <Separator Width="1" Margin="8,4" Background="#2B2B2B"/>
                    <TextBlock x:Name="TxtStatusDatabase" Text="master" Foreground="#CCCCCC" FontSize="11" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
                
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStatusRows" Text="0 rows" Foreground="#CCCCCC" FontSize="11" VerticalAlignment="Center"/>
                    <Separator Width="1" Margin="8,4" Background="#2B2B2B"/>
                    <TextBlock x:Name="TxtStatusColumns" Text="0 columns" Foreground="#CCCCCC" FontSize="11" VerticalAlignment="Center"/>
                    <Separator Width="1" Margin="8,4" Background="#2B2B2B"/>
                    <TextBlock x:Name="TxtStatusTime" Text="0 ms" Foreground="#CCCCCC" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Shared WebView2 Instance for Monaco Editor -->
        <Grid x:Name="SharedWebViewHost" Visibility="Collapsed">
            <wv2:WebView2 x:Name="SharedSqlEditorWebView" Margin="0" AllowExternalDrop="False"/>
        </Grid>
    </Grid>
</Window>
