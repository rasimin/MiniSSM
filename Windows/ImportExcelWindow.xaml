<Window x:Class="SSMS.ImportExcelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Data from Excel" 
        Height="850" Width="1200"
        MinHeight="700" MinWidth="950"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        Background="#181A1F"
        BorderBrush="#2A2D35"
        BorderThickness="1"
        KeyDown="Window_KeyDown">
    
    <Window.Resources>
        <!-- Custom Dark ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#1A1D24"/>
            <Setter Property="Foreground" Value="#D0D0D0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#007ACC"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#252830"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Dark ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#111317"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2A2D35"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="MainGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                            </Grid.ColumnDefinitions>
                            <Popup x:Name="PART_Popup" 
                                   AllowsTransparency="True" 
                                   Grid.ColumnSpan="2" 
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" 
                                   Margin="1" 
                                   PopupAnimation="Slide" 
                                   Placement="Bottom">
                                <Border x:Name="DropDownBorder" 
                                        Background="#1A1D24" 
                                        BorderBrush="#2A2D35" 
                                        BorderThickness="1" 
                                        CornerRadius="2" 
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" 
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                            <Border Grid.ColumnSpan="2" Background="#111317" BorderBrush="#2A2D35" BorderThickness="1" CornerRadius="2"/>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                              Margin="8,5,4,5" 
                                              VerticalAlignment="Center" 
                                              HorizontalAlignment="Left"/>
                            <ToggleButton Grid.Column="1" 
                                          Background="Transparent" 
                                          BorderThickness="0" 
                                          Focusable="False" 
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press">
                                <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="#888C94" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </ToggleButton>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Main Form & Preview -->
            <RowDefinition Height="Auto"/> <!-- Progress / Status -->
            <RowDefinition Height="Auto"/> <!-- Actions -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16" MouseDown="HeaderGrid_MouseDown" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="📊 Import Data from Excel" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold"/>
                <TextBlock Text="Pilih file Excel, tentukan nama tabel baru, lalu impor data ke SQL Server." Foreground="#888C94" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="🗖" Width="24" Height="20" Background="Transparent" BorderThickness="0" Foreground="#888C94" FontSize="11" Click="BtnMaximize_Click" Margin="0,0,4,0" ToolTip="Maximize / Restore">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="✕" Width="20" Height="20" Background="Transparent" BorderThickness="0" Foreground="#888C94" FontSize="12" Click="BtnClose_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#FF5555"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Form & Preview -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Target Database -->
                <RowDefinition Height="Auto"/> <!-- File Path + Browse + Reset -->
                <RowDefinition Height="Auto"/> <!-- Sheet & Target Table Name -->
                <RowDefinition Height="Auto"/> <!-- Max Rows & Options -->
                <RowDefinition Height="*"/>    <!-- Data Preview Grid -->
            </Grid.RowDefinitions>

            <!-- Row 0: Target Database -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Database Tujuan:" Foreground="#888C94" FontSize="12" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" x:Name="TxtTargetDatabase" IsReadOnly="True" Background="#111317" Foreground="#007ACC" BorderBrush="#2A2D35" Padding="8,5" FontSize="12" FontWeight="SemiBold"/>
            </Grid>

            <!-- Row 1: File Path + Browse + Reset -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="File Excel:" Foreground="#888C94" FontSize="12" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" x:Name="TxtFilePath" IsReadOnly="True" Background="#111317" Foreground="#CCCCCC" BorderBrush="#2A2D35" Padding="8,5" FontSize="12"/>
                <Button Grid.Column="2" x:Name="BtnBrowse" Content="Browse..." Margin="8,0,0,0" Padding="12,5" Background="#252830" Foreground="#FFFFFF" BorderBrush="#3F4350" FontSize="12" Click="BtnBrowse_Click"/>
                <Button Grid.Column="3" x:Name="BtnReset" Content="↺ Reset" Margin="6,0,0,0" Padding="10,5" Background="#252830" Foreground="#FF8C00" BorderBrush="#3F4350" FontSize="12" Click="BtnReset_Click" IsEnabled="False"/>
            </Grid>

            <!-- Row 2: Sheet & Target Table -->
            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sheet Dropdown -->
                <TextBlock Grid.Column="0" Text="Worksheet:" Foreground="#888C94" FontSize="12" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" x:Name="CmbSheet" Padding="6,5" FontSize="12" SelectionChanged="CmbSheet_SelectionChanged"/>

                <!-- Target Table Name -->
                <TextBlock Grid.Column="3" Text="Nama Tabel Baru:" Foreground="#888C94" FontSize="12" VerticalAlignment="Center"/>
                <TextBox Grid.Column="4" x:Name="TxtTableName" Background="#111317" Foreground="#FFFFFF" BorderBrush="#2A2D35" Padding="8,5" FontSize="12" TextChanged="TxtTableName_TextChanged"/>
            </Grid>

            <!-- Row 3: Max Preview Rows & Checkbox -->
            <Grid Grid.Row="3" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Max Preview Baris:" Foreground="#888C94" FontSize="12" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" x:Name="TxtMaxRows" Text="100" Background="#111317" Foreground="#FFFFFF" BorderBrush="#2A2D35" Padding="6,4" FontSize="12" HorizontalContentAlignment="Center" TextChanged="TxtMaxRows_TextChanged"/>
                <CheckBox Grid.Column="3" x:Name="ChkFirstRowHeader" Content="Baris pertama adalah Nama Kolom (Header)" IsChecked="True" Foreground="#D0D0D0" FontSize="12" VerticalAlignment="Center" Click="ChkFirstRowHeader_Click"/>
            </Grid>

            <!-- Row 4: Data Preview -->
            <Grid Grid.Row="4" Margin="0,4,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" x:Name="TxtPreviewHeader" Text="Preview Data &amp; Kolom Terdeteksi (Max 100 Baris):" Foreground="#888C94" FontSize="11" Margin="0,0,0,6"/>
                <DataGrid Grid.Row="1" x:Name="GridPreview" AutoGenerateColumns="True" IsReadOnly="True" Background="#111317" Foreground="#D0D0D0" RowBackground="#16181D" AlternatingRowBackground="#1D2027" BorderBrush="#2A2D35" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#2A2D35"/>
            </Grid>
        </Grid>

        <!-- Progress & Status Row -->
        <StackPanel Grid.Row="2" Margin="0,10,0,10">
            <ProgressBar x:Name="ProgressBarImport" Height="4" IsIndeterminate="False" Visibility="Collapsed" Foreground="#007ACC" Background="#111317" BorderThickness="0"/>
            <TextBlock x:Name="TxtStatus" Text="Silakan atur Max Preview Baris lalu pilih file Excel untuk memulai." Foreground="#888C94" FontSize="11" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Buttons Row -->
        <Grid Grid.Row="3" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1" x:Name="BtnImport" Content="⚡ Import Data" Width="120" Height="32" Background="#007ACC" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Click="BtnImport_Click" IsEnabled="False"/>
            <Button Grid.Column="3" x:Name="BtnCancel" Content="Batal" Width="90" Height="32" Background="#252830" Foreground="#CCCCCC" BorderBrush="#3F4350" Click="BtnCancel_Click"/>
        </Grid>
    </Grid>
</Window>
