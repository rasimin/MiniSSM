<Window x:Class="SSMS.SqlAgentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SQL Agent Monitor"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="#D4D4D4"
        FontFamily="Segoe UI, Arial"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        StateChanged="Window_StateChanged"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style x:Key="AgentButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="82"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="BorderBrush" Value="#3C3C3C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#3F3F46"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#555555"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#202020"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#202020"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#2B2B2B"/>
                                <Setter Property="Foreground" Value="#6A6A6A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AgentPrimaryButton" TargetType="Button" BasedOn="{StaticResource AgentButton}">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="BorderBrush" Value="#007ACC"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="BorderBrush" Value="#3C3C3C"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="AgentCodeBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="MinHeight" Value="90"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Background" Value="#181818"/>
            <Setter Property="BorderBrush" Value="#2B2B2B"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderBrush" Value="#2B2B2B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#181818"/>
            <Setter Property="AlternatingRowBackground" Value="#1E1E1E"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#2B2B2B"/>
            <Setter Property="VerticalGridLinesBrush" Value="#2B2B2B"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#202020"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#2B2B2B"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style x:Key="AgentHistoryRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="#181818"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RunStatusCode}" Value="0">
                    <Setter Property="Background" Value="#5A1D1D"/>
                    <Setter Property="Foreground" Value="#F4CCCC"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding RunStatusCode}" Value="2">
                    <Setter Property="Background" Value="#5A1D1D"/>
                    <Setter Property="Foreground" Value="#F4CCCC"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding RunStatusCode}" Value="3">
                    <Setter Property="Background" Value="#5A1D1D"/>
                    <Setter Property="Foreground" Value="#F4CCCC"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding RunStatusCode}" Value="4">
                    <Setter Property="Background" Value="#5A1D1D"/>
                    <Setter Property="Foreground" Value="#F4CCCC"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="BorderBrush" Value="#2B2B2B"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="#9D9D9D"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#2B2B2B"
                                BorderThickness="0,0,1,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#1E1E1E"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#007ACC"/>
                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="0,2,1,0"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#333333"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowCard" Margin="8" Background="#181818" BorderBrush="#3C3C3C" BorderThickness="1" CornerRadius="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.5" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="18,12,18,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="300" MinHeight="180"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="SQL Agent Monitor" Foreground="#F2F2F2" FontSize="14" FontWeight="Bold"/>
                    <TextBlock x:Name="ServerText" Foreground="#8A8A8A" FontSize="11" Margin="12,1,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="—" Width="26" Height="24" Background="Transparent" BorderThickness="0" Foreground="#A0A0A0" FontSize="12" Click="MinimizeButton_Click" ToolTip="Minimize"/>
                    <Button x:Name="MaximizeButton" Content="□" Width="26" Height="24" Background="Transparent" BorderThickness="0" Foreground="#A0A0A0" FontSize="11" Click="MaximizeButton_Click" ToolTip="Maximize / Restore"/>
                    <Button Content="✕" Width="26" Height="24" Background="Transparent" BorderThickness="0" Foreground="#A0A0A0" FontSize="11" Click="CloseButton_Click" ToolTip="Close"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="#202020" BorderBrush="#2B2B2B" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="SQL Server Agent" Foreground="#CCCCCC" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="AgentStatusText" Grid.Column="1" Text="Checking..." Foreground="#CCA700" FontWeight="SemiBold" Margin="14,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="AgentStartupText" Grid.Column="2" Foreground="#8A8A8A" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <TextBlock x:Name="JobsCountText" Grid.Column="3" Foreground="#8A8A8A" VerticalAlignment="Center" Margin="18,0,0,0"/>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Jobs" Foreground="#8A8A8A" FontSize="11.5" VerticalAlignment="Center"/>
                <TextBox x:Name="SearchTextBox" Grid.Column="1" Margin="10,0,0,0" ToolTip="Search job name" KeyDown="SearchTextBox_KeyDown"/>
                <CheckBox x:Name="AutoRefreshCheckBox" Grid.Column="2" Content="Auto-refresh" IsChecked="False" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="14,0,0,0"/>
                <TextBlock x:Name="OperationText" Grid.Column="3" Foreground="#8A8A8A" VerticalAlignment="Center" Margin="14,0,0,0" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button Content="Refresh" Style="{StaticResource AgentButton}" Click="RefreshButton_Click"/>
                    <Button x:Name="StartJobButton" Content="Start Job" Style="{StaticResource AgentPrimaryButton}" Click="StartJobButton_Click" IsEnabled="False"/>
                    <Button x:Name="StopJobButton" Content="Stop Job" Style="{StaticResource AgentButton}" Click="StopJobButton_Click" IsEnabled="False"/>
                    <Button x:Name="ToggleJobButton" Content="Enable/Disable" Style="{StaticResource AgentButton}" Click="ToggleJobButton_Click" IsEnabled="False"/>
                </StackPanel>
            </Grid>

            <DataGrid x:Name="JobsGrid" Grid.Row="3" SelectionChanged="JobsGrid_SelectionChanged" MouseDoubleClick="JobsGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Job Name" Binding="{Binding Name}" Width="250"/>
                    <DataGridTemplateColumn Header="Enabled" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="EnabledIcon" Text="✓" Foreground="#4EC9B0" FontSize="14" FontWeight="Bold" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding EnabledDisplay}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Enabled}" Value="False">
                                        <Setter TargetName="EnabledIcon" Property="Text" Value="✕"/>
                                        <Setter TargetName="EnabledIcon" Property="Foreground" Value="#F14C4C"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Running" Binding="{Binding RunningDisplay}" Width="90"/>
                    <DataGridTextColumn Header="Last Run" Binding="{Binding LastRunDisplay}" Width="150"/>
                    <DataGridTemplateColumn Header="Last Status" Width="105">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="LastStatusBorder" Background="Transparent" CornerRadius="2" Padding="4,1" Margin="1">
                                    <TextBlock x:Name="LastStatusText" Text="{Binding LastRunStatusDisplay}" Foreground="#CCCCCC"/>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding LastRunStatusCode}" Value="0">
                                        <Setter TargetName="LastStatusBorder" Property="Background" Value="#5A1D1D"/>
                                        <Setter TargetName="LastStatusText" Property="Foreground" Value="#F14C4C"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LastRunStatusCode}" Value="2">
                                        <Setter TargetName="LastStatusBorder" Property="Background" Value="#5A1D1D"/>
                                        <Setter TargetName="LastStatusText" Property="Foreground" Value="#F14C4C"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LastRunStatusCode}" Value="3">
                                        <Setter TargetName="LastStatusBorder" Property="Background" Value="#5A1D1D"/>
                                        <Setter TargetName="LastStatusText" Property="Foreground" Value="#F14C4C"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LastRunStatusCode}" Value="4">
                                        <Setter TargetName="LastStatusBorder" Property="Background" Value="#5A1D1D"/>
                                        <Setter TargetName="LastStatusText" Property="Foreground" Value="#F14C4C"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Duration" Binding="{Binding LastRunDurationDisplay}" Width="85"/>
                    <DataGridTextColumn Header="Next Run" Binding="{Binding NextRunDisplay}" Width="150"/>
                    <DataGridTextColumn Header="Schedule" Binding="{Binding ScheduleDisplay}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Row="4"
                          Height="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          Background="#2B2B2B"
                          BorderBrush="#3C3C3C"
                          BorderThickness="0,1,0,1"
                          ResizeDirection="Rows"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="True"
                          Cursor="SizeNS"
                          ToolTip="Drag to resize detail panel"/>

            <Border Grid.Row="5" Background="#202020" BorderBrush="#2B2B2B" BorderThickness="1" CornerRadius="4" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="DetailTitleText" Text="Select a job" Foreground="#CCCCCC" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock x:Name="DetailMetaText" Foreground="#8A8A8A" FontSize="11" Margin="12,1,0,0"/>
                        </StackPanel>
                    </Grid>
                    <TabControl x:Name="DetailTabs" Grid.Row="1" Background="#1E1E1E" BorderThickness="0">
                        <TabItem Header="Steps">
                            <DataGrid x:Name="StepsGrid" Margin="0,6,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding StepId}" Width="45"/>
                                    <DataGridTextColumn Header="Step Name" Binding="{Binding StepName}" Width="180"/>
                                    <DataGridTextColumn Header="Subsystem" Binding="{Binding Subsystem}" Width="100"/>
                                    <DataGridTextColumn Header="Database" Binding="{Binding DatabaseName}" Width="150"/>
                                    <DataGridTextColumn Header="Retries" Binding="{Binding RetryAttempts}" Width="70"/>
                                    <DataGridTextColumn Header="Command" Binding="{Binding Command}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="Schedules">
                            <DataGrid x:Name="SchedulesGrid" Margin="0,6,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Schedule" Binding="{Binding Name}" Width="220"/>
                                    <DataGridTextColumn Header="Enabled" Binding="{Binding EnabledDisplay}" Width="80"/>
                                    <DataGridTextColumn Header="Frequency" Binding="{Binding FrequencyDescription}" Width="330"/>
                                    <DataGridTextColumn Header="Active Window" Binding="{Binding ActiveWindowDisplay}" Width="260"/>
                                    <DataGridTextColumn Header="Next Run" Binding="{Binding NextRunDisplay}" Width="160"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem x:Name="HistoryTab" Header="History">
                            <Grid Margin="0,6,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="100" MinHeight="70"/>
                                </Grid.RowDefinitions>
                                <DataGrid x:Name="HistoryGrid" RowStyle="{StaticResource AgentHistoryRowStyle}" SelectionChanged="HistoryGrid_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Run Time" Binding="{Binding RunTimeDisplay}" Width="150"/>
                                        <DataGridTextColumn Header="Step" Binding="{Binding StepDisplay}" Width="180"/>
                                        <DataGridTemplateColumn Header="Status" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="HistoryStatusBorder" Background="Transparent" CornerRadius="2" Padding="4,1" Margin="1">
                                                        <TextBlock x:Name="HistoryStatusText" Text="{Binding RunStatusDisplay}" Foreground="#CCCCCC"/>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding RunStatusCode}" Value="0">
                                                            <Setter TargetName="HistoryStatusBorder" Property="Background" Value="#5A1D1D"/>
                                                            <Setter TargetName="HistoryStatusText" Property="Foreground" Value="#F14C4C"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RunStatusCode}" Value="2">
                                                            <Setter TargetName="HistoryStatusBorder" Property="Background" Value="#5A1D1D"/>
                                                            <Setter TargetName="HistoryStatusText" Property="Foreground" Value="#F14C4C"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RunStatusCode}" Value="3">
                                                            <Setter TargetName="HistoryStatusBorder" Property="Background" Value="#5A1D1D"/>
                                                            <Setter TargetName="HistoryStatusText" Property="Foreground" Value="#F14C4C"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RunStatusCode}" Value="4">
                                                            <Setter TargetName="HistoryStatusBorder" Property="Background" Value="#5A1D1D"/>
                                                            <Setter TargetName="HistoryStatusText" Property="Foreground" Value="#F14C4C"/>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Duration" Binding="{Binding DurationDisplay}" Width="85"/>
                                        <DataGridTextColumn Header="Retries" Binding="{Binding Retries}" Width="65"/>
                                        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBox x:Name="HistoryMessageTextBox" Grid.Row="1" Margin="0,6,0,0" Style="{StaticResource AgentCodeBox}"/>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
